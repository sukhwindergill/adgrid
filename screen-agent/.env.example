# Copy this file to .env and fill in your values
# Get SCREEN_TOKEN from the Setup Guide tab on your screen's detail page

SCREEN_TOKEN=your-screen-token-here
SUPABASE_URL=https://hkqiuwnppxkkztacwicj.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Pins which built image version this device runs (see docker-compose.yml).
# Defaults to the commit pinned there if unset. Bump deliberately to pick up
# a newer screen-agent build (find the commit SHA in the CI run that built
# it, or `git log --oneline -- screen-agent/`) — never leave this on
# `latest`, which would auto-deploy every merge to main to every live screen.
# SCREEN_AGENT_TAG=<git-sha-of-the-build-you-want>
