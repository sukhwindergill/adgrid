# Copy to /etc/adgrid-display.env
#
# Default: open the pairing page. The screen shows a 6-character code;
# type it into your screen's Setup Guide in the AdGrid dashboard and the
# display connects itself (and remembers it across reboots).
DISPLAY_URL=https://app.adgrid.io/pair
#
# Advanced: skip pairing by pointing straight at the player. The token is
# on the Setup Guide tab; treat this URL like a password.
# DISPLAY_URL=https://app.adgrid.io/display/YOUR_SCREEN_TOKEN_HERE
