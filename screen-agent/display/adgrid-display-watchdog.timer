# Runs adgrid-display-watchdog.service every 5 minutes. See that unit for
# why this exists (S20 — recovering a crash-looped kiosk with no SSH access).

[Unit]
Description=Run AdGrid display watchdog every 5 minutes

[Timer]
OnBootSec=2min
OnUnitActiveSec=5min
AccuracySec=30s
Persistent=true

[Install]
WantedBy=timers.target
