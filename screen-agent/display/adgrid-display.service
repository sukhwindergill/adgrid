# AdGrid Display Player — systemd unit
#
# Autostart AdGrid display player in kiosk mode on boot.
#
# Install:
#   sudo cp adgrid-display.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable adgrid-display
#   sudo systemctl start adgrid-display
#
# Configure display URL before starting:
#   sudo cp adgrid-display.env.example /etc/adgrid-display.env
#   sudo nano /etc/adgrid-display.env

[Unit]
Description=AdGrid Display Player
After=network-online.target graphical.target
Wants=network-online.target

[Service]
Type=simple
# Change 'pi' to your actual username (run: whoami). bootstrap.sh does this
# and fills in the matching XDG_RUNTIME_DIR uid below.
User=pi
EnvironmentFile=-/etc/adgrid-display.env
# Defaults to the pairing page if /etc/adgrid-display.env is missing.
Environment=DISPLAY_URL=https://app.adgrid.io/pair
# Raspberry Pi OS Bookworm runs Wayland (labwc); older images and most mini
# PCs run X11. Set both so Chromium finds whichever session is up;
# --ozone-platform-hint=auto picks Wayland when WAYLAND_DISPLAY is live.
Environment=DISPLAY=:0
Environment=WAYLAND_DISPLAY=wayland-0
Environment=XDG_RUNTIME_DIR=/run/user/1000
ExecStartPre=/bin/sleep 5
# Bookworm ships the binary as `chromium`; older Raspberry Pi OS / Ubuntu
# images call it `chromium-browser`. $$ escapes $ from systemd for the shell.
ExecStart=/bin/sh -c 'exec "$$(command -v chromium || command -v chromium-browser)" \
  --no-sandbox \
  --kiosk \
  --noerrdialogs \
  --disable-infobars \
  --no-first-run \
  --password-store=basic \
  --disable-session-crashed-bubble \
  --disable-translate \
  --ozone-platform-hint=auto \
  --check-for-update-interval=604800 \
  --app="$$DISPLAY_URL"'
Restart=always
RestartSec=10
StartLimitIntervalSec=60
StartLimitBurst=5

[Install]
WantedBy=graphical.target
