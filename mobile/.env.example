# Copy to .env and fill in real values (from the Supabase project settings,
# or ask another operator on the team). .env is git-ignored -- see
# README.md for why that means these vars also need setting separately via
# `eas env:create` before a real (non-dev) build will work.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
