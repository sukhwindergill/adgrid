    "moduleNameMapper": {
      "^@adgrid/core(.*)$": "<rootDir>/../packages/core$1"
    },
    "transformIgnorePatterns": [
      "node_modules[/\\\\](?!\\.pnpm|((jest-)?react-native|@react-native|expo(nent)?|@expo(nent)?|@expo-google-fonts|react-navigation|@react-navigation|@unimodules|unimodules|sentry-expo|native-base|react-native-svg))"
    ]
  }
